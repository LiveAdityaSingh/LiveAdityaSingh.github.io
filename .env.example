# ── MLTVA Environment Configuration ──
# Copy this file to .env and fill in the values.

# Ollama configuration (local LLM inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=koesn/llama3-openbiollm-8b

# Data paths
MIMIC_DATA_PATH=./data/raw/mimic-iv
MIMIC_NOTE_PATH=./data/raw/mimic-iv-note
MIMIC_ECG_PATH=./data/raw/mimic-iv-ecg

# Logging
LOG_LEVEL=INFO
